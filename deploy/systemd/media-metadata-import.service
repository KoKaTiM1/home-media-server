[Unit]
Description=Seed helper metadata batches and import acknowledged results
Requires=media-stack.service
After=media-stack.service
RequiresMountsFor=/srv/dev-disk-by-uuid-<MEDIA_FILESYSTEM_UUID>

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec catalogue-bridge python /app/app.py metadata-import
Nice=15
TimeoutStartSec=90
