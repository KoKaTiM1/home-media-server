[Unit]
Description=Find guarded Russian-audio alternatives with source-matched Hebrew subtitles
Requires=media-stack.service
After=media-stack.service
RequiresMountsFor=/srv/dev-disk-by-uuid-<APPDATA_FILESYSTEM_UUID>

[Service]
Type=oneshot
ExecStartPre=/usr/bin/systemctl start media-verification-guard.service
ExecStart=/usr/bin/docker exec catalogue-bridge python /app/app.py russian-audio
TimeoutStartSec=450s
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
