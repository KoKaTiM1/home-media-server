[Unit]
Description=Coordinate Windows media sample verification lane 4
Requires=media-stack.service
After=media-stack.service media-verification-coordinator.service
RequiresMountsFor=/srv/dev-disk-by-uuid-<MEDIA_FILESYSTEM_UUID>

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec catalogue-bridge python /app/app.py remote-availability --slot 4
TimeoutStartSec=18min
Nice=15
