[Unit]
Description=Restricted Tailscale TCP passthrough to the verification coordinator
After=media-verification-coordinator.service

[Service]
Type=exec
User=server
Group=users
ExecStart=/usr/lib/systemd/systemd-socket-proxyd <SERVER_LAN_IP>:8095
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=<WINDOWS_TAILSCALE_IP>/32
IPAddressAllow=<SERVER_LAN_IP>/32
MemoryMax=64M
CPUQuota=20%
TasksMax=20
