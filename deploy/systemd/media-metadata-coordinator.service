[Unit]
Description=Restricted LAN metadata coordinator for the Windows helper
Wants=network-online.target
After=network-online.target media-stack.service
RequiresMountsFor=/srv/dev-disk-by-uuid-<MEDIA_FILESYSTEM_UUID> /srv/dev-disk-by-uuid-bd267f22-f18a-4966-94ae-409a27252905

[Service]
Type=simple
User=server
Group=users
UMask=0007
Environment=PYTHONPATH=/usr/local/lib/home-media-metadata
LoadCredential=metadata-config:/opt/media-stack/secrets/metadata_coordinator.json
LoadCredential=metadata-token:/opt/media-stack/secrets/metadata_worker_token
LoadCredential=metadata-cert:/opt/media-stack/secrets/metadata_tls_cert.pem
LoadCredential=metadata-key:/opt/media-stack/secrets/metadata_tls_key.pem
ExecStart=/usr/bin/python3 /usr/local/lib/home-media-metadata/coordinator.py --config ${CREDENTIALS_DIRECTORY}/metadata-config
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/srv/dev-disk-by-uuid-bd267f22-f18a-4966-94ae-409a27252905/appdata/metadata-coordinator
IPAddressDeny=any
IPAddressAllow=<WINDOWS_METADATA_HELPER_IP>/32
IPAddressAllow=<SERVER_LAN_IP>/32
MemoryMax=128M
CPUQuota=25%
TasksMax=16

[Install]
WantedBy=multi-user.target
