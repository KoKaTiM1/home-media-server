[Unit]
Description=Retain verified torrent metadata for future playback
Requires=media-stack.service
After=media-stack.service
RequiresMountsFor=/srv/dev-disk-by-uuid-<APPDATA_FILESYSTEM_UUID>

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec catalogue-bridge python /app/app.py torrent-metadata
TimeoutStartSec=65s
Nice=19

