[Unit]
Description=Restricted Windows media verification gateway
Wants=network-online.target
After=network-online.target media-stack.service
RequiresMountsFor=/srv/dev-disk-by-uuid-<MEDIA_FILESYSTEM_UUID> /srv/dev-disk-by-uuid-bd267f22-f18a-4966-94ae-409a27252905
[Service]
Type=simple
User=server
Group=users
UMask=0007
Environment=PYTHONPATH=/usr/local/lib/home-media-verification
LoadCredential=config:/opt/media-stack/secrets/verification_coordinator.json
LoadCredential=verification-token:/opt/media-stack/secrets/verification_worker_token
LoadCredential=tls-cert:/opt/media-stack/secrets/metadata_tls_cert.pem
LoadCredential=tls-key:/opt/media-stack/secrets/metadata_tls_key.pem
ExecStart=/usr/bin/python3 /usr/local/lib/home-media-verification/coordinator.py --config ${CREDENTIALS_DIRECTORY}/config
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/srv/dev-disk-by-uuid-bd267f22-f18a-4966-94ae-409a27252905/appdata/verification-worker
IPAddressDeny=any
IPAddressAllow=<WINDOWS_METADATA_HELPER_IP>/32
IPAddressAllow=<SERVER_LAN_IP>/32
IPAddressAllow=<VERIFICATION_DOCKER_SUBNET>
MemoryMax=128M
CPUQuota=50%
TasksMax=40
[Install]
WantedBy=multi-user.target
