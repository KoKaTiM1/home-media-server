[Unit]
Description=Prepare independent Windows verification work ahead (producer %i)
Requires=media-stack.service
After=media-stack.service media-verification-coordinator.service
RequiresMountsFor=/srv/dev-disk-by-uuid-<APPDATA_FILESYSTEM_UUID> /srv/dev-disk-by-uuid-<MEDIA_FILESYSTEM_UUID>

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec catalogue-bridge python /app/app.py remote-availability --slot %i
TimeoutStartSec=18min
Nice=15
