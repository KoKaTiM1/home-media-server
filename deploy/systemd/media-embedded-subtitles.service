[Unit]
Description=Cache embedded Hebrew subtitles from requested exact media sources
Requires=media-stack.service
After=media-stack.service media-verification-guard.service
RequiresMountsFor=/srv/dev-disk-by-uuid-<APPDATA_FILESYSTEM_UUID>

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec catalogue-bridge python /app/app.py embedded-subtitles
TimeoutStartSec=125s
Nice=19
