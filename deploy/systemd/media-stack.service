[Unit]
Description=Jellyfin and Transmission media stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/dev-disk-by-uuid-<MEDIA_FILESYSTEM_UUID> /srv/dev-disk-by-uuid-bd267f22-f18a-4966-94ae-409a27252905

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/media-stack
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
